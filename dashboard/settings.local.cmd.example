@echo off
rem העתיקו קובץ זה ל-settings.local.cmd ומלאו את שני הערכים.
rem הקובץ settings.local.cmd אינו נכנס ל-git.

rem כתובת ה-Worker שנפרס:
set ZN_COLLECTOR=https://zmanei-nezach-usage.YOURNAME.workers.dev

rem מזהה הסוד ב-Bitwarden Secrets Manager שמכיל את ADMIN_TOKEN.
rem הטוקן עצמו לעולם לא נכתב כאן.
set ZN_TOKEN_SECRET_ID=00000000-0000-0000-0000-000000000000

rem נדרש כדי ש-bws יוכל לגשת לכספת:
rem set BWS_ACCESS_TOKEN=...   (עדיף להגדיר כמשתנה סביבה קבוע במערכת)
